    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "test:sharing-cloud": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test --test-concurrency=1 tests/firestore-rules.integration.mjs tests/sharing-cloud.integration.mjs tests/sharing-flow.integration.mjs tests/sharing-v2-cloud.integration.mjs tests/sharing-private-calendar-cloud.integration.mjs",
