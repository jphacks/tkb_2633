  "scripts": {
    "postinstall": "node ./scripts/patch-hermes-podspec-encoding.cjs && node ./scripts/patch-expo-widget-open-app.cjs && node ./scripts/patch-google-signin-silent-tokens.cjs && node ./scripts/patch-expo-task-manager-headless.cjs",
