# Public OAuth client IDs only. Never put a client secret or access token here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Firebase public mobile bootstrap values (Firebase console: project settings → web app).
# These are not administrator credentials. Firestore access must be protected by the checked-in Rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Enable only after Apple Developer / Firebase Apple provider setup is complete.
EXPO_PUBLIC_APPLE_SHARING_ENABLED=false

# Shared groups use v2 only; the retired V2_ENABLED flag cannot enable v1 creation.

# The standard Firestore Rules include owner-confirmed recovery.
# Set false only for an older Rules deployment that has not received those paths.
EXPO_PUBLIC_SHARING_OWNER_RECOVERY=true

# Optional local iOS signing team, applied to the app and widget targets at build time.
APPLE_TEAM_ID=
