{
  "expo": {
    "name": "LiFlow",
    "slug": "housework-planner",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/liflow-icon.png",
    "scheme": "houseworkplanner",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "jp.jphacks.tkb2633",
      "icon": "./assets/images/liflow-icon.png"
    },
    "android": {
      "package": "jp.jphacks.tkb2633",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/liflow-icon.png",
        "backgroundColor": "#5AA2D7"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/liflow-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5AA2D7",
          "image": "./assets/images/liflow-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "./plugins/with-android-widget-completion",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.jp.jphacks.tkb2633",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextChoreWidget",
              "displayName": "次の家事",
              "description": "今日の家事を最大3件表示します",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/platform/widgets/NextChoreWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "initialLayout": "src/platform/widgets/NextChoreWidget.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-background-task",
      "./plugins/with-liflow-launcher-icons",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "jp.jphacks.tkb2633.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.jp.jphacks.tkb2633"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "b32c351a-bf4f-461c-9aae-02335eebd129"
      }
    }
  }
}
