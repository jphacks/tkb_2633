{
  "name": "housework-planner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "expo": "~58.0.19",
    "expo-background-task": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/patch-hermes-podspec-encoding.cjs && node ./scripts/patch-expo-widget-open-app.cjs && node ./scripts/patch-google-signin-silent-tokens.cjs",
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "XCODE_XCCONFIG_FILE=./ios-build.xcconfig expo run:ios",
    "web": "expo start --web",
    "api:dev": "node --env-file-if-exists=.env.server server/appliance-care-api/src/index.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "doctor": "npx expo-doctor"
  },
  "private": true
}
