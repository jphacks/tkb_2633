{
  "expo": {
    "name": "家事お知らせアプリ",
    "slug": "housework-planner",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "houseworkplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "jp.jphacks.tkb2633",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "jp.jphacks.tkb2633",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "天気に合わせて洗濯予定を調整するため、現在地のおおよその座標を使います。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.jp.jphacks.tkb2633",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextChoreWidget",
              "displayName": "次の家事",
              "description": "次に行う家事を表示します",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "src/platform/widgets/NextChoreWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "initialLayout": "src/platform/widgets/NextChoreWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
